generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Player {
  id          String   @id @default(cuid())
  name        String
  position    String
  overall     Int
  nationality String
  club        String
  age         Int
  height      String
  weight      String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

